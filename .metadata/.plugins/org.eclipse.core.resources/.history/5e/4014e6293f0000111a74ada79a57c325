package airplane;

public class AirplaneName {
	
	private int number;
	private String seatOx;
	
	public AirplaneName(int number, String seatOx) {
		this.number = number;
		this.seatOx = seatOx;
	}

	@Override
	public String toString() {
		return "AirplaneName = " + this.number + " : " + this.seatOx ;
	}
	
	
	
